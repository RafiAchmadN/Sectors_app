# Salin ke .env lalu isi. File .env TIDAK boleh di-commit (lihat .gitignore).

# Sectors Financial API v2 — https://sectors.app/api (butuh plan Insider)
# Dikirim sebagai header: Authorization: <key>  (raw, TANPA prefix "Bearer")
SECTORS_API_KEY=

# Telegram Bot (BotFather) — dipakai di tahap delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets service account — dipakai di tahap logging
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# n8n instance lokal (docker compose di /home/rafiachn/n8n) — dipakai script deploy-workflow.js
# Buat dari: n8n UI -> Settings -> n8n API -> Create an API key
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
